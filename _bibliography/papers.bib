@article{zhang2014forward,
  title={Forward--Backward Splitting Method for Quantitative Photoacoustic Tomography},
  author={Zhang, Xue and Zhou, Weifeng and Zhang, Xiaoqun and Gao, Hao},
  journal={Inverse problems},
  volume={30},
  number={12},
  pages={125012},
  year={2014},

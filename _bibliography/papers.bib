@article{bao2016image,
  title={Image Restoration by Minimizing Zero Norm of Wavelet Frame Coefficients},
  author={Bao, Chenglong and Dong, Bin and Hou, Likun and Shen, Zuowei and Zhang, Xiaoqun and Zhang, Xue},

---
layout: default
---
<div class="post limo-member">
  <header class="limo-member-hero">
    <img
      src="{{ 'assets/img/people/' | append: page.img | relative_url }}"
      alt="Portrait of {{ page.title | escape }}"
      class="limo-member-hero__image"
      width="180"
      height="180"
    >
    <div>
      <p class="limo-member-hero__position">{{ page.position | default: page.category }}</p>
      <h1 class="post-title">
        {{ page.title }}
        {% if page.name_zh %}
          <span class="limo-member-hero__name-zh">({{ page.name_zh }})</span>
        {% endif %}
      </h1>
      {% if page.category != 'Faculty' and page.research_areas and page.research_areas.size > 0 %}
        <ul class="limo-member-hero__topics" aria-label="Research areas">
          {% for area in page.research_areas %}
            {% assign area_data = site.data.publication_topics | where: 'id', area | first %}
            {% assign area_label = area_data.label %}
            {% unless area_label %}
              {% assign area_label = area | capitalize %}
            {% endunless %}
            <li>{{ area_label }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </header>

  <article>
    <div class="limo-member__bio">{{ content }}</div>

    {% if page.cv %}
      <div class="limo-cv">
        {% for entry in site.data.cv[page.cv] %}
          {% assign entry_id = entry.title | slugify %}
          <section class="limo-cv__section" aria-labelledby="{{ entry_id }}">
            <h2 id="{{ entry_id }}" class="limo-cv__section-title">{{ entry.title }}</h2>
            {% case entry.type %}
              {% when 'list' %}
                {% include limo/cv/list.liquid %}
              {% when 'map' %}
                {% include limo/cv/map.liquid %}
              {% when 'nested_list' %}
                {% include limo/cv/nested-list.liquid %}
              {% when 'time_table' %}
                {% include limo/cv/timeline.liquid %}
              {% when 'list_groups' %}
                {% include limo/cv/list-groups.liquid %}
              {% when 'publications' %}
                {% include limo/cv/publications.liquid %}
              {% else %}
                {{ entry.contents }}
            {% endcase %}
          </section>
        {% endfor %}
      </div>
    {% endif %}
  </article>

  {% capture member_publication_count -%}
    {% bibliography_count --query @*[limo_members ~= \b{{ page.member_id }}\b] %}
  {%- endcapture %}
  {% assign member_publication_count = member_publication_count | strip | plus: 0 %}

  {% if member_publication_count > 0 %}
    <section class="limo-member-publications" aria-labelledby="member-publications-heading">
      <header class="limo-section-heading limo-member-publications__header">
        <h2 id="member-publications-heading" class="limo-section-title">Publications</h2>
        <a href="{{ '/publications/' | relative_url }}">View all publications <span aria-hidden="true">→</span></a>
      </header>
      <div class="publications no_toc_section">
        {% bibliography --group_by none --query @*[limo_members ~= \b{{ page.member_id }}\b] %}
      </div>
    </section>
  {% endif %}
</div>

{% if member_publication_count > 0 %}
  <script src="{{ '/assets/js/limo-publication-disclosures.js' | relative_url }}"></script>
{% endif %}

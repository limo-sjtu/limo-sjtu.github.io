{% assign item = include.item %}
<article class="limo-activity-item">
  <div class="limo-activity-item__meta">
    <time class="limo-activity-item__date">
      {{- item.date -}}
      {%- if item.year %}, {{ item.year }}{% endif -%}
    </time>
    {% if item.slides -%}
      <a class="limo-activity-item__slides" href="{{ item.slides | relative_url }}">Slides</a>
    {%- endif %}
  </div>
  <div class="limo-activity-item__body">
    <h3>{{ item.title }}</h3>
    {% if item.session %}
      <p>
        {% if item.session_url -%}
          <a href="{{ item.session_url }}">{{ item.session }}</a>
        {%- else -%}
          {{- item.session -}}
        {%- endif %}
      </p>
    {% endif %}
    <p>
      {% if item.conf_url -%}
        <a href="{{ item.conf_url }}">{{ item.conference }}</a>
      {%- else -%}
        {{- item.conference -}}
      {%- endif %}
      {% if item.location -%}
        <span aria-hidden="true"> · </span>{{ item.location -}}
      {%- endif %}
    </p>
  </div>
</article>
